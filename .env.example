# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.gpjru2a.mongodb.net/chatbot?retryWrites=true&w=majority&appName=Cluster0

# OpenAI API Settings (Default fallback)
