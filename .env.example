# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.gpjru2a.mongodb.net/chatbot?retryWrites=true&w=majority&appName=Cluster0

# OpenRouter & OpenAI-compatible inference settings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=nex-agi/nex-n2.5-pro:free

# Fallback OpenAI API Key (if switching to direct OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Secret key for AES encryption (32-byte hex)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
